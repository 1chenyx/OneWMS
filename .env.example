# OneWMS 运行配置模板：复制为 .env 后按需填写（.env 含密钥，已被 .gitignore 忽略）

# ── AI Provider（缺 ONE_AI_MODEL 时 AI 入口关闭，server 照常启动，/api/chat 503）──
# 云 API：kind=openai-compatible，baseUrl 必填（如智谱 https://open.bigmodel.cn/api/paas/v4）
ONE_AI_KIND=openai-compatible
ONE_AI_MODEL=
ONE_AI_BASE_URL=
ONE_AI_API_KEY=
# 本地 Ollama：kind=ollama，model 填如 qwen3:8b，baseUrl 缺省 http://localhost:11434/v1，无需 key
# ONE_AI_KIND=ollama
# ONE_AI_MODEL=qwen3:8b

# ── Server ──
# ONE_DB_PATH=data/onewms.db
# ONE_WORKSPACE=default
# ONE_PORT=3000

# ── 自动备份（默认每天一份、保留最近 7 份，落在数据库同目录的 backups/）──
# 设置页「备份」可随时手动备份 / 恢复 / 删除；备份文件含事件账本与 AI 配置。
# ONE_BACKUP_INTERVAL_MS=86400000   # 轮询间隔；0 = 关闭自动备份（只留手动）
# ONE_BACKUP_KEEP=7                 # 最多保留几份（最小 1，超出自动删最旧的）
# ONE_BACKUP_DIR=                   # 自定义备份目录（缺省 = 数据库同目录的 backups/）

# ── 多节点同步（可选）──
# 推荐走页面：「设置 → 节点」看本机局域网地址（含二维码），对方在「设置 → 局域网同步」添加节点，
# 配对关系保存在数据库同目录的 peers.json，重启仍在。下面两个变量是给服务器部署用的补充入口。
# ONE_SYNC_PEERS=                   # 每轮都会一并同步的对端地址，逗号分隔
# ONE_SYNC_INTERVAL_MS=30000        # 后台自动同步间隔
# ONE_PEERS_PATH=                   # 自定义配对清单路径（缺省 = 数据库同目录的 peers.json）

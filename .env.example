# OneWMS 运行配置模板：复制为 .env 后按需填写（.env 含密钥，已被 .gitignore 忽略）

# ── AI Provider（缺 ONE_AI_MODEL 时 AI 入口关闭，server 照常启动，/api/chat 503）──
# 云 API：kind=openai-compatible，baseUrl 必填（如智谱 https://open.bigmodel.cn/api/paas/v4）
ONE_AI_KIND=openai-compatible
ONE_AI_MODEL=
ONE_AI_BASE_URL=
ONE_AI_API_KEY=
# 本地 Ollama：kind=ollama，model 填如 qwen3:8b，baseUrl 缺省 http://localhost:11434/v1，无需 key
# ONE_AI_KIND=ollama
# ONE_AI_MODEL=qwen3:8b

# ── Server ──
# ONE_DB_PATH=data/onewms.db
# ONE_WORKSPACE=default
# ONE_PORT=3000

# ── 多节点同步 / 云中继（可选，启用时取消注释）──
# ONE_SYNC_PEERS=
# ONE_SYNC_INTERVAL_MS=30000
# ONE_RELAY_URL=
# ONE_RELAY_INTERVAL_MS=60000

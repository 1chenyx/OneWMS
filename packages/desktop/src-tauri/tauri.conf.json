{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OneWMS",
  "version": "0.1.0",
  "identifier": "com.onewms.desktop",
  "build": {
    "frontendDist": "../../app/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }

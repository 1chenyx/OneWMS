{
  "name": "@one/wms",
  "version": "0.1.0",
  "description": "OneWMS 仓储领域包：SKU / 单据状态机 / 库存流水（只依赖 @one/core 公共 API）",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "npm run build -w @one/core",
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build -w @one/core",
    "test": "vitest run",
    "pretypecheck": "npm run build -w @one/core",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@one/core": "^0.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
